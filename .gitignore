# ==============================================================================
# Root .gitignore — Proteção global do repositório
# ==============================================================================

# Variáveis de Ambiente e Segredos (NUNCA commitar)
.env
.env.*
.env.local
!.env.example

# Node / Frontend
node_modules/
dist/
dist-ssr/
*.local

# Python / Backend
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Docker Compose overrides
docker-compose.override.yml

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editores e SO
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

build/